# ============================================================
# 4b. 言語必須ルール（OR）
# ============================================================
#
# 子項目を選択する場合、
# リスト内の前提科目のうち「少なくとも1つ」を選択する必要がある。
#
# child <= sum(parents)
#
# and_prerequisitesとの違い：
#
#   and_prerequisites：リストの全項目が必要（AND）
#   or_prerequisites ：リストのいずれか1項目でよい（OR）
#
# 分野によっては言語の選択肢が複数あるため、
# 「どれか1つ学べばよい」という関係をここに書く。
#
# 例：
#
# モバイルUIを選ぶ
#     → Swift/KotlinかFlutter/RNのどちらかが必要
#
# Gitを選ぶ
#     → フロントエンド・バックエンド・モバイル・QAのいずれかの
#       言語を1つ以上選んでいる必要がある
#       （Gitは複数分野にまたがる汎用ツールのため、
#         特定の1分野の言語だけに縛らない）

or_prerequisites = {
    "SQL/データベース": [
        "バックエンド言語",
        "Python基礎",
